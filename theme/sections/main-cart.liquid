<section class="cart">
  <div class="wrap">
    <h1 style="margin-bottom:32px;">Your bag</h1>

    {% if cart.item_count > 0 %}
      {% form 'cart' %}
        <table class="cart-table">
          <thead>
            <tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td>
                  <div class="cart-line">
                    {% if item.image %}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">{% endif %}
                    <div>
                      <a href="{{ item.url }}" style="font-weight:600;">{{ item.product.title }}</a>
                      <p class="mono" style="color:var(--concrete); margin-top:4px;">{{ item.variant.title }}</p>
                    </div>
                  </div>
                </td>
                <td class="mono">{{ item.original_price | money }}</td>
                <td>
                  <input type="number" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0" style="width:56px; font-family:var(--font-mono); border:2px solid var(--ink); padding:6px;">
                </td>
                <td class="mono">{{ item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="cart-summary">
          <div class="cart-summary__box">
            <div class="cart-summary__row cart-summary__row--total">
              <span>Subtotal</span><span>{{ cart.total_price | money }}</span>
            </div>
            <p class="mono" style="color:var(--concrete); margin: 8px 0 20px;">Taxes and shipping calculated at checkout.</p>
            <button type="submit" name="checkout" class="btn btn--red" style="width:100%;">Checkout</button>
          </div>
        </div>
      {% endform %}
    {% else %}
      <div class="cart-empty">
        <p class="mono" style="margin-bottom:20px;">Your bag is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--red">Continue shopping</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
