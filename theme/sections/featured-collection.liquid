{%- assign coll = collections[section.settings.collection] -%}
<section class="section">
  <div class="wrap">
    <div class="section__head">
      <h2>{{ section.settings.heading }}</h2>
      {% if coll %}<a href="{{ coll.url }}" class="mono">View all &rarr;</a>{% endif %}
    </div>
    <div class="grid">
      {% if coll %}
        {% for product in coll.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New drops" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
