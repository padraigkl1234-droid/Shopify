<div class="pill-nav">
  <a href="{{ routes.root_url }}" class="pill-nav__logo">PAD<span>.</span>CO</a>
  <button class="pill-nav__toggle" id="MenuToggle" aria-expanded="false" aria-controls="MenuOverlay">
    <span class="pill-nav__toggle-label">Menu</span>
  </button>
</div>

<div class="menu-overlay" id="MenuOverlay">
  <button class="menu-overlay__close" id="MenuClose" aria-label="Close menu">Close</button>

  <nav class="menu-overlay__links">
    {% for link in linklists[section.settings.menu].links %}
      <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {% endfor %}
  </nav>

  <div class="menu-overlay__foot">
    <div class="menu-overlay__foot-links">
      <a href="{{ routes.search_url }}">Search</a>
      <a href="{{ routes.account_url }}">Account</a>
    </div>
    <a href="{{ routes.cart_url }}" class="menu-overlay__cart">
      Bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
